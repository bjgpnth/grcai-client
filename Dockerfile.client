# gRCAi Client Runtime Dockerfile
#
# Build with context = directory that contains grcai-contracts and grcai-client
# (e.g. grcai-mvp). Contracts are copied from grcai-contracts at build time;
# they are NOT stored in this repo.
#
# From monorepo root (grcai-mvp):
#   docker build -f grcai-client/Dockerfile.client -t grcai/client .
#
# Excludes all Central/IP components (llm/, prompts/, central_service/).

FROM python:3.12-slim

LABEL org.opencontainers.image.title="gRCAi Client Runtime"
LABEL org.opencontainers.image.description="Client runtime for gRCAi - excludes all IP-protected reasoning components"
LABEL org.opencontainers.image.vendor="gRCAi"
LABEL org.opencontainers.image.component="client"
LABEL org.opencontainers.image.architecture="amd64"

WORKDIR /grcai

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        procps \
        net-tools \
        curl \
        iputils-ping \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Contracts: copied from sibling grcai-contracts at build time (not from this repo)
COPY grcai-contracts/ /grcai/contracts/

# Client code and dependencies
COPY grcai-client/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY grcai-client/main.py .
COPY grcai-client/__version__.py .
COPY grcai-client/client/ ./client/
COPY grcai-client/connectors/ ./connectors/
COPY grcai-client/orchestrator/ ./orchestrator/
COPY grcai-client/evidence_store/ ./evidence_store/
COPY grcai-client/ui/ ./ui/
COPY grcai-client/config/ ./config/
COPY grcai-client/utils/ ./utils/

RUN mkdir -p /config/initial /config/template /config/defaults
COPY grcai-client/config/initial/ /config/initial/
COPY grcai-client/config/template/ /config/template/
COPY grcai-client/config/defaults/ /config/defaults/
COPY grcai-client/config/reasoning_budget.yaml grcai-client/config/env_schema.json /config/
ENV GRCAI_CONFIG_HOME=/config
ENV GRCAI_SESSIONS_HOME=/grcai/grcai_sessions

ENV PYTHONUNBUFFERED=1
ENV GRCAI_REASONING_MODE=remote
ENV GRCAI_CENTRAL_URL=https://grcai-central-dev.militva.dev
ENV CONTRACTS_PATH=/grcai/contracts
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

RUN useradd -m -u 1000 grcai && \
    chown -R grcai:grcai /grcai /config

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1
USER grcai
CMD ["python", "main.py", "--help"]
