# gRCAi Client Runtime Dockerfile
#
# Build with context = grcai-client repo root. Contracts are copied from
# the in-repo contracts/ folder (populate from grcai-contracts if needed).
#
# From grcai-client root (e.g. after clone or install-docker.sh):
#   docker build -f Dockerfile.client -t grcai/client .
#
# Excludes all Central/IP components (llm/, prompts/, central_service/).

FROM python:3.12-slim

LABEL org.opencontainers.image.title="gRCAi Client Runtime"
LABEL org.opencontainers.image.description="Client runtime for gRCAi - excludes all IP-protected reasoning components"
LABEL org.opencontainers.image.vendor="gRCAi"
LABEL org.opencontainers.image.component="client"
LABEL org.opencontainers.image.architecture="amd64"

WORKDIR /grcai

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        procps \
        net-tools \
        curl \
        iputils-ping \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Contracts: from in-repo contracts/ (populate from grcai-contracts repo)
COPY contracts/ /grcai/contracts/

# Client code and dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY main.py .
COPY __version__.py .
COPY client/ ./client/
COPY connectors/ ./connectors/
COPY orchestrator/ ./orchestrator/
COPY evidence_store/ ./evidence_store/
COPY ui/ ./ui/
COPY config/ ./config/
COPY utils/ ./utils/

RUN mkdir -p /config/initial /config/template /config/defaults
COPY config/initial/ /config/initial/
COPY config/template/ /config/template/
COPY config/defaults/ /config/defaults/
COPY config/reasoning_budget.yaml config/env_schema.json /config/
ENV GRCAI_CONFIG_HOME=/config
ENV GRCAI_SESSIONS_HOME=/grcai/grcai_sessions

ENV PYTHONUNBUFFERED=1
ENV GRCAI_REASONING_MODE=remote
ENV GRCAI_CENTRAL_URL=https://grcai-central-dev.militva.dev
ENV CONTRACTS_PATH=/grcai/contracts
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

RUN useradd -m -u 1000 grcai && \
    chown -R grcai:grcai /grcai /config

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1
USER grcai
CMD ["python", "main.py", "--help"]
